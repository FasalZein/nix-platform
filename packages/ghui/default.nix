# ghui 0.9.1, the newest release (Homebrew has 0.9.0, the locked nixpkgs 0.4.6),
# as an override of nixpkgs' ghui: same build (bun build:cli), same wrapper.
# Lockfile and npmDeps hash: ./update-lock.sh regenerates both.
#
# Upstream ships only bun.lock, so package-lock.json here is generated by npm
# from the v0.9.1 package.json; it follows npm's resolution on the day it runs
# (as nixpkgs' nix-update --generate-lockfile does), not bun.lock's
# transitive versions. Direct dependencies are exact in package.json.
# buildNpmPackage computes npmDeps from its arguments, not from the override,
# so npmDeps is set here.
#
# dev/build-cli.ts bundles @effect/sql-sqlite-bun, and bun 1.4.4 renames the
# `export * from "effect/unstable/sql/Migrator"` namespace in only one place:
# the app stops on "ReferenceError: Migrator2 is not defined" at boot. It is a
# runtime dependency in package.json, so it is left external like effect is.
#
# Checks (flake.nix): ghui-start boots the built app; ghui-override-needed
# fails once nixpkgs ships this version or a newer one (then delete this
# folder and use nixpkgs' ghui); pin-drift compares the version with
# expected-versions.nix.
{ lib, ghui, fetchFromGitHub, fetchNpmDeps, bun }:

ghui.overrideAttrs (old: rec {
  version = "0.9.1";
  src = fetchFromGitHub {
    owner = "kitlangton";
    repo = "ghui";
    tag = "v${version}";
    hash = "sha256-K051E6+da+JZs16Kna6/Xnwhkk5b6alpC3AT/4kq4pY=";
  };
  postPatch = ''
    cp ${./package-lock.json} package-lock.json
    substituteInPlace dev/build-cli.ts \
      --replace-fail 'external: [' 'external: ["@effect/sql-sqlite-bun", '
  '';
  npmDeps = fetchNpmDeps {
    name = "ghui-${version}-npm-deps";
    inherit src postPatch;
    hash = "sha256-2i7rkQi8K/+Pq/mw3TA+Gekm3elak8m+Tiv1eVVsnZU="; # npmDeps hash
    fetcherVersion = 2;
  };
  # nixpkgs' check imports the runtime dependencies; 0.9.1 adds this one.
  postInstallCheck = old.postInstallCheck + ''
    ${lib.getExe bun} -e 'await import("@effect/sql-sqlite-bun")'
  '';
  # The nixpkgs version this overrides, for the ghui-override-needed check.
  passthru = old.passthru // { nixpkgsVersion = ghui.version; };
})
